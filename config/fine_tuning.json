{
  "base_model": "YichuanMa/LoGos-7B",
  "train_file": "local/finetuning/data/train.json",
  "output_dir": "local/models/logos-qlora",
  "cache_dir": "local/cache",
  "quantization": {
    "load_in_4bit": true,
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_use_double_quant": true
  },
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "training": {
    "max_length": 3072,
    "packing": false,
    "num_train_epochs": 2,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 5e-05,
    "max_grad_norm": 1.0,
    "logging_steps": 10,
    "logging_strategy": "steps",
    "eval_strategy": "no",
    "save_strategy": "steps",
    "save_steps": 400,
    "save_total_limit": 2,
    "load_best_model_at_end": false,
    "optim": "paged_adamw_8bit",
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03,
    "report_to": "none",
    "seed": 42,
    "data_seed": 42
  }
}
